  },
  "homepage": "https://github.com/praballl/zee-css#readme",
  "bugs": {
    "url": "https://github.com/praballl/zee-css/issues"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@zee-css/core": "^1.0.0",
    "glob": "^13.0.6"
  }
}
