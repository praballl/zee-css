{
  "name": "@zee-css/cli",
  "version": "1.0.0",
  "description": "CLI tool for zee-css - scans your project and generates CSS from utility class usage",
  "main": "dist/index.js",
  "bin": {
    "zee-css": "dist/index.js"
  },
  "files": [
